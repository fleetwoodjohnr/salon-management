{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Salon Resource Manager",
  "mainBinaryName": "salon-resource-manager",
  "version": "0.2.0",
  "identifier": "app.salonresourcemanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Salon Resource Manager",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "msi",
      "dmg",
      "app"
    ],
    "category": "Business",
    "publisher": "Salon Resource Manager contributors",
    "shortDescription": "Costing, inventory, pricing and sales for salon professionals",
    "longDescription": "Salon Resource Manager is a free, offline-first desktop app for independent salon professionals and small salons: work-profile costing, bulk inventory, service recipes, transparent pricing, sales tax, clients, appointments, sales and dashboards.",
    "copyright": "MIT License",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyRDAxNEYyNTgxMUZFQUMKUldTcy9oRlk4aFRRSWpERVUzVldCTzRyV29vczh5ZWFrcWFRWmdIcW5jOTk2UjQ4elUzd3BZK1kK",
      "endpoints": [
        "https://github.com/fleetwoodjohnr/salon-management/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
